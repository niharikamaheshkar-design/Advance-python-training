        "id": "79125832",
        "outputId": "172fe87e-7a1d-4adf-ac6c-c7721b3496e9"
      },
      "source": [
        "\n",
        "num = 123\n",
        "ones = num % 10\n",
        "tens = (num // 10) % 10\n",
        "hundreds = num // 100\n",
        "reversed_num_math = (ones * 100) + (tens * 10) + hundreds\n",
        "print(\"Original:\", num)\n",
        "print(\"Reversed (Math):\", reversed_num_math)\n",
        "reversed_num_slice = int(str(num)[::-1])\n",
        "print(\"Reversed (Slicing):\", reversed_num_slice)"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Original: 123\n",
            "Reversed (Math): 321\n",
            "Reversed (Slicing): 321\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "num = int(input(\"Enter a 3-digit number: \"))\n",
        "a = num // 100\n",
        "b = (num // 10) % 10\n",
        "c = num % 10\n",
        "rev = c * 100 + b * 10 + a\n",
        "print(\"Reversed number:\", rev)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "jd4qo3W6XIGw",
