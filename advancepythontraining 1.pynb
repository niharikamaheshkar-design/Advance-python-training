    {
      "cell_type": "code",
      "source": [
        "class a:\n",
        "  def showa(self):\n",
        "    print(\"showa function\")\n",
        "class b(a):\n",
        "  def showb(self):\n",
        "    print(\"showb function\")\n",
        "obj=b()\n",
        "obj.showa()\n",
        "obj.showb()\n"
      ],
      "metadata": {
