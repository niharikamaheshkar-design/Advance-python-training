    {
      "cell_type": "markdown",
      "source": [
        "Hierarchical inheritance"
      ],
      "metadata": {
        "id": "SPQ0EUXh-UC6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Hierarchical inheritance definition\n",
        "class D:\n",
        "    def showD(self):\n",
        "        print(\"showD function (Base Class)\")\n",
        "\n",
        "class A(D):\n",
        "    def showA(self):\n",
        "        print(\"showA function\")\n",
        "\n",
        "class B(D):\n",
        "    def showB(self):\n",
        "        print(\"showB function\")\n",
        "\n",
        "class C(D):\n",
        "    def showC(self):\n",
        "        print(\"showC function\")\n",
        "\n",
        "# Creating objects and calling methods\n",
        "obj1 = A()\n",
        "obj1.showA()\n",
        "obj1.showD()\n",
        "\n",
