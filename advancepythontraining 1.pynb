    {
      "cell_type": "code",
      "source": [
        "class Student:\n",
        "    def __init__(self):\n",
        "        self.rollno = int(input(\"Enter roll number: \"))\n",
        "        self.name = input(\"Enter name: \")\n",
        "\n",
        "        self.m1 = int(input(\"Enter paper 1 marks: \"))\n",
        "        self.m2 = int(input(\"Enter paper 2 marks: \"))\n",
        "        self.m3 = int(input(\"Enter paper 3 marks: \"))\n",
        "        self.m4 = int(input(\"Enter paper 4 marks: \"))\n",
        "        self.m5 = int(input(\"Enter paper 5 marks: \"))\n",
        "\n",
        "    def calculate(self):\n",
        "        total = self.m1 + self.m2 + self.m3 + self.m4 + self.m5\n",
        "        percentage = total / 5\n",
        "\n",
        "        print(\"Roll No:\", self.rollno)\n",
        "        print(\"Name:\", self.name)\n",
        "        print(\"Total:\", total)\n",
        "        print(\"Percentage:\", percentage)\n",
        "\n",
        "        if percentage >= 85:\n",
        "            print(\"Student can take admission\")\n",
        "        else:\n",
        "            print(\"Student can't take admission\")\n",
        "\n",
        "\n",
        "s1 = Student()\n",
        "s1.calculate()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "81nJumda1uuM",
        "outputId": "e892926c-c4e1-4337-9f54-615b8b8621ab"
      },
