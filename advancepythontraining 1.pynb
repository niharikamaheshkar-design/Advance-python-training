      "cell_type": "code",
      "source": [
        "class a:\n",
        "  def showa(self):\n",
        "    print(\"showa function\")\n",
        "class b(a):\n",
        "  def showb(self):\n",
        "    print(\"showb function\")\n",
        "class c(b):\n",
        "  def showc(self):\n",
        "    print(\"showc function\")\n",
        "obj=c()\n",
        "obj.showa()\n",
        "obj.showb()\n",
        "obj.showc()"
